# ============================================
# Humanly — Environment Variables
# ============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real credentials.

# ── Frontend (exposed to browser — no secrets here) ──
VITE_APP_NAME=Humanly
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# ── Server-side only (Cloudflare secrets in production) ──
# These are used by Cloudflare Pages Functions at runtime.
# In local dev, they're read from .env.local via wrangler.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Application Config ──
APP_ENV=development
MAX_WORDS_PER_REQUEST=800
ENABLE_DAILY_LIMIT=false
BETA_DAILY_REQUESTS_PER_USER=999999
GLOBAL_DAILY_REQUEST_CAP=999999
MODEL_REQUESTS_ENABLED=true

# ── Optional: Cloudflare Turnstile ──
# TURNSTILE_SITE_KEY=your_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
